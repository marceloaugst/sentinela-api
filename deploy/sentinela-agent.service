# /etc/systemd/system/sentinela-agent.service
# Instalação: veja deploy/install-agent.sh. O agente só faz requisições de SAÍDA. A única coisa que executa a pedido da API
# é `systemctl start|stop|restart` nas unidades do catálogo, e só porque a regra polkit deploy/50-sentinela-agent.rules deixa.
# Docker (opcional): `update.sh --docker` cria o drop-in sentinela-agent.service.d/docker.conf com SupplementaryGroups=docker,
# o que permite listar/iniciar/reiniciar containers. Acesso ao socket do Docker equivale a root: só ative se aceitar esse risco.
[Unit]
Description=Sentinela Agent (monitoramento)
Documentation=https://github.com/seu-usuario/sentinela
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/sentinela-agent
Environment=SENTINELA_API_URL=https://sentinela.exemplo.com
# O token fica em arquivo 0600 do root, lido via credencial do systemd (não aparece em `ps` nem em /proc/<pid>/environ).
LoadCredential=agent-token:/etc/sentinela/agent-token
Environment=SENTINELA_AGENT_TOKEN_FILE=%d/agent-token
Restart=always
RestartSec=5
DynamicUser=yes
# Logs (opcional): remova o comentário da linha abaixo para enviar nginx, fail2ban e ufw à API.
#Environment=SENTINELA_LOGS=nginx,fail2ban,ufw
# Caminhos diferentes do padrão: SENTINELA_LOG_NGINX_ACCESS_PATH, SENTINELA_LOG_NGINX_ERROR_PATH,
# SENTINELA_LOG_FAIL2BAN_PATH, SENTINELA_LOG_UFW_PATH. Para gravar TODO pedido do nginx: SENTINELA_LOG_NGINX_ALL=true
# O grupo "adm" dá LEITURA em /var/log/nginx, fail2ban.log e ufw.log (Debian/Ubuntu); o agente não escreve neles.
SupplementaryGroups=adm
# Posição de leitura dos logs (sobrevive a reinícios), em /var/lib/sentinela
StateDirectory=sentinela
StateDirectoryMode=0700
# Endurecimento: o agente lê /proc, /sys e statfs; sem capabilities (o systemctl pede autorização ao polkit via D-Bus).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
CapabilityBoundingSet=
MemoryMax=96M
CPUQuota=20%

[Install]
WantedBy=multi-user.target
