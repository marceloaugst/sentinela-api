APP_ENV=development            # development | test | production
HTTP_ADDR=:8080
LOG_LEVEL=info

# Usado pelo compose para o serviço postgres (não use valores de exemplo em produção)
POSTGRES_PASSWORD=
# Fora do compose, informe a URL completa:
DATABASE_URL=
AUTO_MIGRATE=false

REDIS_URL=                     # opcional
CORS_ALLOWED_ORIGINS=          # lista separada por vírgulas, ex.: https://painel.exemplo.com

# Chave de AUTOMAÇÃO (opcional, papel admin, sem 2º fator). Vazia = desativada (recomendado em produção).
# Se usar: mínimo 32 caracteres; gere com: openssl rand -hex 32
ADMIN_API_KEY=
# true somente atrás de proxy reverso confiável que define X-Real-IP (Nginx)
TRUST_PROXY=false

AGENT_COLLECT_INTERVAL_SECONDS=15
AGENT_RATE_LIMIT_PER_SECOND=2
AGENT_RATE_LIMIT_BURST=10
AGENT_IP_RATE_LIMIT_PER_SECOND=20   # por IP de origem; suba se muitos agentes saem pelo mesmo NAT/IP
AGENT_IP_RATE_LIMIT_BURST=60
AGENT_HEARTBEAT_TIMEOUT_SECONDS=60
METRICS_RETENTION_DAYS=30
RETENTION_INTERVAL_MINUTES=60   # frequência do job que apaga métricas antigas

DB_MAX_CONNS=10
DB_MIN_CONNS=1
MAX_BODY_BYTES=1048576
REQUEST_TIMEOUT_SECONDS=25

# Segredos em repouso (tokens de canais). 32 bytes em hex: openssl rand -hex 32
SECRETS_KEY=
TELEGRAM_BOT_TOKEN=            # opcional; exige SECRETS_KEY e TELEGRAM_CHAT_ID
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=     # destinos autorizados para canais criados pela API (vírgulas)
ALERT_EVALUATION_INTERVAL_SECONDS=15

# Tempo real (SSE)
SSE_HEARTBEAT_SECONDS=15
SSE_MAX_CLIENTS=500
SSE_MAX_CLIENTS_PER_IP=20
EVENTS_RETENTION_HOURS=24
NOTIFICATION_MAX_ATTEMPTS=8

# Porta do host (loopback) onde a API é publicada pelo compose
API_HOST_PORT=8080

# ---- Autenticação de usuários (Fase 6) ----
# Primeiro administrador: crie com `sentinela-api create-admin --email ...` (senha pela entrada padrão), ou
# defina os três abaixo UMA vez e REMOVA ADMIN_BOOTSTRAP_PASSWORD depois do primeiro start (só age se não houver usuários).
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_NAME=Administrador
ADMIN_BOOTSTRAP_PASSWORD=

SESSION_ABSOLUTE_HOURS=24       # vida máxima da sessão
SESSION_IDLE_MINUTES=120        # expira após esse tempo sem uso
COOKIE_SECURE=                  # padrão: true em produção (exige HTTPS), false em desenvolvimento
COOKIE_SAMESITE=lax             # lax | strict | none (none exige COOKIE_SECURE=true; frontend em outro site)
LOGIN_MAX_FAILURES=5            # por (e-mail, IP); por IP = 4x; por e-mail = 6x
LOGIN_LOCK_MINUTES=15
ARGON2_MEMORY_KIB=65536         # custo do hash de senha (produção: >= 19456 e tempo >= 2)
ARGON2_TIME=3
ARGON2_THREADS=2
API_RATE_LIMIT_PER_SECOND=30    # por IP (por instância)
API_RATE_LIMIT_BURST=100
METRICS_TOKEN=                  # se definido, /metrics exige "Authorization: Bearer <token>" (>= 16 caracteres)
AUDIT_RETENTION_DAYS=365        # 0 = manter para sempre

# ---- Logs (ClickHouse): nginx, fail2ban e firewall (ufw) coletados pelo agente ----
CLICKHOUSE_PASSWORD=            # obrigatório no compose; gere com: openssl rand -hex 24
LOGS_RETENTION_DAYS=90          # o ClickHouse apaga sozinho (TTL) o que passar disso
# Fora do compose, use CLICKHOUSE_URL (ex.: http://127.0.0.1:8123), CLICKHOUSE_DB, CLICKHOUSE_USER e CLICKHOUSE_PASSWORD.
# Sem CLICKHOUSE_URL o recurso fica desativado (as rotas /logs respondem 503).
